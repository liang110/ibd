{
  "schema_version": "protocol-control-1.0",
  "required_prediction_columns": [
    "direction",
    "model",
    "run_id",
    "sample_id",
    "participant_id",
    "y_true",
    "y_prob",
    "origin"
  ],
  "required_multiplicity_columns": [
    "direction",
    "replicate_id",
    "participant_id",
    "multiplicity"
  ],
  "objects": {
    "A": {
      "scoring_unit": "sample",
      "probability_aggregation": "none",
      "metric_aggregation": "mean_over_runs"
    },
    "B": {
      "scoring_unit": "sample",
      "probability_aggregation": "mean_over_runs",
      "metric_aggregation": "single_metric"
    },
    "C": {
      "scoring_unit": "participant",
      "probability_aggregation": "none",
      "metric_aggregation": "mean_over_runs"
    },
    "D": {
      "scoring_unit": "participant",
      "probability_aggregation": "mean_over_runs",
      "metric_aggregation": "single_metric"
    }
  },
  "metrics": [
    "AUROC",
    "AP",
    "Brier"
  ],
  "uncertainty_target": "point_estimate_only; multiplicity fixture is validated but no interval is estimated in this control",
  "input_selection": {
    "direction": "PRISM_to_HMP2",
    "model": "shallow_mlp",
    "n_runs": 10,
    "n_samples": 385,
    "n_participants": 105
  },
  "source_registry": "evidence/full_reproducibility_inputs/prediction_registry.csv"
}
