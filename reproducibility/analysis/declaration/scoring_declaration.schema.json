{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post-fit scoring declaration for fixed binary participant status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "direction",
    "target",
    "model",
    "endpoint",
    "positive_class",
    "positive_label",
    "label_policy",
    "assessment_time",
    "eligibility",
    "order_key",
    "order_basis",
    "expected_runs",
    "metrics",
    "ties",
    "draw_set",
    "expected_draws",
    "one_class",
    "point",
    "interval",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "direction": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "positive_class": {
      "type": "string",
      "minLength": 1
    },
    "positive_label": {
      "const": 1
    },
    "label_policy": {
      "const": "fixed_within_participant"
    },
    "assessment_time": {
      "enum": [
        "after_collection_of_all_retained_specimens",
        "at_first_retained_collection",
        "after_up_to_two_retained_collections"
      ]
    },
    "eligibility": {
      "enum": [
        "all_retained",
        "earliest_retained",
        "first_two_retained"
      ]
    },
    "order_key": {
      "const": "retained_order"
    },
    "order_basis": {
      "type": "string",
      "minLength": 1
    },
    "expected_runs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "roc_auc",
          "average_precision",
          "brier"
        ]
      }
    },
    "ties": {
      "const": "half_credit_auroc_grouped_threshold_step_ap"
    },
    "draw_set": {
      "const": "shared_target_participant_multiplicities"
    },
    "expected_draws": {
      "type": "integer",
      "minimum": 1
    },
    "one_class": {
      "const": "reject_draw"
    },
    "point": {
      "const": "complete_eligible_target"
    },
    "interval": {
      "const": "participant_percentile_95_linear_within_draw_contrasts"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "const": {
              "object": "A",
              "evaluation_record": "specimen",
              "target_weighting": "equal_specimens",
              "within_person": "retain_specimens",
              "across_runs": "average_run_metrics"
            }
          },
          {
            "const": {
              "object": "B",
              "evaluation_record": "specimen",
              "target_weighting": "equal_specimens",
              "within_person": "retain_specimens",
              "across_runs": "average_probabilities"
            }
          },
          {
            "const": {
              "object": "C",
              "evaluation_record": "participant",
              "target_weighting": "equal_participants",
              "within_person": "mean_probability",
              "across_runs": "average_run_metrics"
            }
          },
          {
            "const": {
              "object": "D",
              "evaluation_record": "participant",
              "target_weighting": "equal_participants",
              "within_person": "mean_probability",
              "across_runs": "average_probabilities"
            }
          },
          {
            "const": {
              "object": "E",
              "evaluation_record": "specimen",
              "target_weighting": "equal_participants",
              "within_person": "retain_specimens",
              "across_runs": "average_run_metrics"
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eligibility": {
            "const": "all_retained"
          }
        }
      },
      "then": {
        "properties": {
          "assessment_time": {
            "const": "after_collection_of_all_retained_specimens"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eligibility": {
            "const": "earliest_retained"
          }
        }
      },
      "then": {
        "properties": {
          "assessment_time": {
            "const": "at_first_retained_collection"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eligibility": {
            "const": "first_two_retained"
          }
        }
      },
      "then": {
        "properties": {
          "assessment_time": {
            "const": "after_up_to_two_retained_collections"
          }
        }
      }
    }
  ]
}
